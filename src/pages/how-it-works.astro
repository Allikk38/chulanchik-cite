---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { howItWorks } from '@/content/howItWorks';
import { withBase } from '@/utils/seo';
---

<BaseLayout
  title="Как это работает"
  description="Четыре шага: приносите вещи, мы оцениваем, продаём в магазине, вы получаете деньги. Ответы на частые вопросы."
>
  <article class="how">
    <Container>
      <header class="how__header">
        <span class="how__eyebrow">Как это работает</span>
        <h1 class="how__title">Четыре простых шага</h1>
        <p class="how__lead">
          От ваших вещей до денег на руках — без лишних хлопот и сложных условий.
        </p>
      </header>

      <ol class="how__steps">
        {howItWorks.map((step) => (
          <li class="how__step">
            <span class="how__step-num" aria-hidden="true">{step.number}</span>
            <div class="how__step-body">
              <h2 class="how__step-title">{step.title}</h2>
              <p class="how__step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <section class="how__faq">
        <h2 class="how__faq-title">Частые вопросы</h2>

        <div class="how__faq-list">
          <details class="how__faq-item">
            <summary>Сколько стоит сдать вещь?</summary>
            <p>
              Сдача в «Чуланчик» — бесплатна. Мы зарабатываем только когда
              вещь продаётся: берём оговорённый процент с продажи.
            </p>
          </details>

          <details class="how__faq-item">
            <summary>Как вы определяете цену?</summary>
            <p>
              Смотрим на состояние вещи, её востребованность и рыночную цену.
              Обсуждаем с вами — вы всегда знаете, за сколько вещь уйдёт
              и сколько вы получите.
            </p>
          </details>

          <details class="how__faq-item">
            <summary>Сколько ждать, пока вещь продастся?</summary>
            <p>
              По-разному: от нескольких дней до нескольких недель. Если вещь
              долго не уходит — можем снизить цену по согласованию с вами
              или вернуть её вам.
            </p>
          </details>

          <details class="how__faq-item">
            <summary>Что если вещь не продастся?</summary>
            <p>
              Вы можете забрать её обратно — без штрафов. Или оставить
              нам с пониженной ценой, чтобы она всё-таки нашла хозяина.
            </p>
          </details>

          <details class="how__faq-item">
            <summary>Как вы выплачиваете деньги?</summary>
            <p>
              Переводим на карту или отдаём наличными — как вам удобно.
              Сразу после продажи.
            </p>
          </details>
        </div>
      </section>

      <div class="how__cta">
        <p class="how__cta-text">
          Остались вопросы? Приходите в магазин или пишите.
        </p>
        <a href={withBase('/contacts')} class="how__cta-btn">
          Все контакты
        </a>
      </div>
    </Container>
  </article>
</BaseLayout>

<style>
  .how { padding-block: 120px var(--space-9); }

  .how__header {
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .how__eyebrow {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-terra);
    margin-bottom: var(--space-3);
  }

  .how__title {
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-5);
  }

  .how__lead {
    font-size: var(--fs-lg);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
    max-width: 60ch;
  }

  .how__steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 720px;
    margin-bottom: var(--space-9);
  }

  .how__step {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }

  .how__step-num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #ffffff;
    font-weight: var(--fw-bold);
    font-size: var(--fs-lg);
  }

  .how__step-title {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
    line-height: 1.25;
  }

  .how__step-text {
    font-size: var(--fs-base);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
  }

  .how__faq {
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .how__faq-title {
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.2;
    margin-bottom: var(--space-5);
    letter-spacing: -0.01em;
  }

  .how__faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .how__faq-item {
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }

  .how__faq-item summary {
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: var(--space-6);
  }

  .how__faq-item summary::-webkit-details-marker { display: none; }

  .how__faq-item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--fs-xl);
    font-weight: var(--fw-regular);
    color: var(--color-primary);
    transition: transform var(--transition-base);
    line-height: 1;
  }

  .how__faq-item[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .how__faq-item p {
    margin-top: var(--space-3);
    font-size: var(--fs-base);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
  }

  .how__cta {
    max-width: 720px;
    padding: var(--space-6);
    background: var(--color-primary-bg);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .how__cta-text {
    font-size: var(--fs-md);
    color: var(--color-text);
    font-weight: var(--fw-medium);
  }

  .how__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: #ffffff;
    font-weight: var(--fw-semibold);
    padding: 12px var(--space-5);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .how__cta-btn:hover {
    background: var(--color-primary-light);
    color: #ffffff;
  }
</style>