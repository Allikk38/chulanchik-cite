---
import Container from '@/components/Container.astro';
import { howItWorks } from '@/content/howItWorks';
---

<section class="how-it-works section">
  <Container>
    <header class="how-it-works__header">
      <h2 class="how-it-works__title">Как это работает</h2>
      <p class="how-it-works__lead">
        Четыре простых шага — от ваших вещей до денег на руках.
      </p>
    </header>

    <ol class="how-it-works__list">
      {howItWorks.map((step) => (
        <li class="how-it-works__item">
          <span class="how-it-works__num" aria-hidden="true">{step.number}</span>
          <h3 class="how-it-works__step-title">{step.title}</h3>
          <p class="how-it-works__step-text">{step.text}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .how-it-works__header {
    margin-bottom: var(--space-6);
    max-width: 620px;
  }

  .how-it-works__title {
    margin-bottom: var(--space-3);
  }

  .how-it-works__lead {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
  }

  .how-it-works__list {
    list-style: none;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .how-it-works__list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .how-it-works__list { grid-template-columns: repeat(4, 1fr); }
  }

  .how-it-works__item {
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }

  .how-it-works__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #ffffff;
    font-weight: var(--fw-bold);
    font-size: var(--fs-md);
    margin-bottom: var(--space-4);
  }

  .how-it-works__step-title {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
  }

  .how-it-works__step-text {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
  }
</style>