---
import { Picture } from 'astro:assets';
import Container from '@/components/Container.astro';
import { withBase } from '@/utils/seo';
import sellCtaImage from '@/assets/images/sell-cta.jpg';
---

<section class="sell-cta">
  <Container>
    <div class="sell-cta__grid">
      <div class="sell-cta__content">
        <h2 class="sell-cta__title">Сдайте ненужное — получите выгоду</h2>
        <p class="sell-cta__text">
          Принимаем товары в хорошем состоянии на комиссию или выкупаем сразу.
          Быстро, честно, удобно.
        </p>
        <a href={withBase('/sell')} class="btn btn--light">
          Узнать условия
        </a>
      </div>

      <div class="sell-cta__media">
        <Picture
          src={sellCtaImage}
          alt="Вещи, которые можно сдать в комиссионный магазин «Чуланчик»"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 720, 960, 1200, 1600]}
          sizes="(max-width: 1023px) 100vw, 50vw"
          quality={88}
          loading="lazy"
        />
      </div>
    </div>
  </Container>
</section>

<style>
  .sell-cta {
    background: var(--color-primary);
    color: #ffffff;
    padding-block: var(--space-7);
    margin-block: var(--space-7);
  }

  @media (min-width: 768px) {
    .sell-cta {
      padding-block: var(--space-8);
      margin-block: var(--space-8);
    }
  }

  .sell-cta__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .sell-cta__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .sell-cta__title {
    color: #ffffff;
    margin-bottom: var(--space-4);
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
  }

  .sell-cta__text {
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: var(--space-6);
    max-width: 52ch;
  }

  .sell-cta__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-primary-dark);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }

  .sell-cta__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>