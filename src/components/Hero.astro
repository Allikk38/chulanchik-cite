---
import Container from '@/components/Container.astro';
import { withBase } from '@/utils/seo';
---

<section class="hero">
  <Container>
    <div class="hero__inner">
      <h1 class="hero__title">Хорошие вещи — по честным ценам</h1>
      <p class="hero__lead">
        Чуланчик — комиссионный магазин, где ненужные вещи находят новых
        хозяев, а люди — выгоду и уют.
      </p>
      <div class="hero__actions">
        <a href={withBase('/catalog')} class="hero__btn hero__btn--primary">
          Смотреть каталог
        </a>
        <a href={withBase('/sell')} class="hero__btn hero__btn--secondary">
          Сдать товар
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
    background:
      radial-gradient(ellipse at top right, rgba(201, 122, 61, 0.08), transparent 60%),
      radial-gradient(ellipse at bottom left, rgba(26, 60, 42, 0.06), transparent 55%),
      var(--color-bg);
  }

  @media (min-width: 768px) {
    .hero { padding-block: var(--space-9) var(--space-8); }
  }

  .hero__inner {
    max-width: 720px;
  }

  .hero__title {
    margin-bottom: var(--space-4);
  }

  .hero__lead {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
    max-width: 52ch;
    margin-bottom: var(--space-6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-semibold);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .hero__btn--primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .hero__btn--primary:hover {
    background: var(--color-primary-light);
    color: #ffffff;
  }

  .hero__btn--secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
  }

  .hero__btn--secondary:hover {
    background: var(--color-primary-bg);
    color: var(--color-primary);
  }
</style>