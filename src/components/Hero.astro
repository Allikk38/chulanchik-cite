---
import { Image } from 'astro:assets';
import Container from '@/components/Container.astro';
import { withBase } from '@/utils/seo';
import heroImage from '@/assets/images/hero.jpg';
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={[800, 1200, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      format="webp"
      quality={82}
      class="hero__bg-image"
    />
    <div class="hero__overlay"></div>
  </div>

  <Container>
    <div class="hero__content">
      <h1 class="hero__title">
        Хорошие вещи<br />по честным ценам
      </h1>
      <p class="hero__lead">
        Техника, мебель, инструменты, товары для дома — и многое другое.
        Комиссионный магазин «Чуланчик».
      </p>
      <div class="hero__actions">
        <a href={withBase('/catalog')} class="hero__btn hero__btn--primary">
          Смотреть каталог
        </a>
        <a href={withBase('/sell')} class="hero__btn hero__btn--secondary">
          Сдать товар
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #ffffff;
    display: flex;
    align-items: center;
    min-height: 480px;
    /* верх — с запасом под фиксированную шапку (72px) + «воздух» */
    padding-top: calc(72px + var(--space-7));
    padding-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .hero {
      min-height: 540px;
      padding-top: calc(72px + var(--space-8));
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 580px;
      padding-top: calc(72px + var(--space-8));
    }
  }

  /* -------- Фон -------- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Мягкое затемнение: сильно слева (там текст), слабее справа */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(15, 25, 18, 0.78) 0%,
      rgba(15, 25, 18, 0.55) 40%,
      rgba(15, 25, 18, 0.25) 75%,
      rgba(15, 25, 18, 0.15) 100%
    );
  }

  @media (max-width: 767px) {
    .hero__overlay {
      background: linear-gradient(
        180deg,
        rgba(15, 25, 18, 0.75) 0%,
        rgba(15, 25, 18, 0.6) 100%
      );
    }
  }

  /* -------- Контент -------- */
  .hero__content {
    max-width: 560px;
  }

  .hero__title {
    color: #ffffff;
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.15;
    font-weight: var(--fw-bold);
    margin-bottom: var(--space-4);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.3);
  }

  .hero__lead {
    font-size: var(--fs-md);
    line-height: var(--lh-base);
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-6);
    max-width: 46ch;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.25);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-base);
    padding: 14px var(--space-6);
    border-radius: var(--radius-md);
    border: 1.5px solid transparent;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  /* Зелёная кнопка — как в референсе */
  .hero__btn--primary {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .hero__btn--primary:hover {
    background: var(--color-primary-light);
    border-color: var(--color-primary-light);
    color: #ffffff;
  }

  /* Белая кнопка — как в референсе */
  .hero__btn--secondary {
    background: #ffffff;
    color: var(--color-text);
    border-color: #ffffff;
  }

  .hero__btn--secondary:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-bg-secondary);
    color: var(--color-text);
  }
</style>