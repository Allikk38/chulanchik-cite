---
import Container from '@/components/Container.astro';
import { site } from '@/content/site';
import { navigation } from '@/content/navigation';
import { withBase } from '@/utils/seo';
import '@/styles/components/header.css';

// Текущий путь без base и без trailing slash
const RAW_BASE = import.meta.env.BASE_URL ?? '/';
const BASE = RAW_BASE.endsWith('/') ? RAW_BASE.slice(0, -1) : RAW_BASE;

const pathname = Astro.url.pathname;
// Путь без base: '/', '/about', '/sell' и т.д.
const pathWithoutBase = BASE && pathname.startsWith(BASE)
  ? pathname.slice(BASE.length) || '/'
  : pathname;

// Главная — только '/'
const isHome = pathWithoutBase === '/' || pathWithoutBase === '';

// На внутренних страницах шапка сразу «прилипшая» (кремовая, тёмный текст)
const initialScrolled = !isHome;

const currentPath = pathWithoutBase.replace(/\/$/, '') || '/';
---

<header
  class:list={['site-header', { 'is-scrolled': initialScrolled }]}
  data-header
  data-initial-scrolled={initialScrolled ? 'true' : 'false'}
>
  <Container>
    <div class="site-header__inner">
      <a
        href={withBase('/')}
        class="site-header__logo"
        aria-label={`${site.name} — на главную`}
      >
        <span class="site-header__logo-name">{site.name}</span>
        <span class="site-header__logo-sub">{site.tagline}</span>
      </a>

      <button
        type="button"
        class="site-header__burger"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="primary-navigation"
        data-burger
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav
        id="primary-navigation"
        class="site-header__nav"
        aria-label="Основная навигация"
        data-nav
      >
        <ul class="site-header__nav-list">
          {navigation.map((item) => {
            const itemPath = withBase(item.href).replace(BASE, '').replace(/\/$/, '') || '/';
            const isActive = currentPath === itemPath;
            return (
              <li>
                <a
                  href={withBase(item.href)}
                  class:list={['site-header__nav-link', { 'is-active': isActive }]}
                >
                  {item.label}
                  {item.note && <span class="site-header__nav-note">{item.note}</span>}
                </a>
              </li>
            );
          })}
        </ul>

        <a href={withBase('/sell')} class="site-header__cta">Сдать товар</a>
      </nav>
    </div>
  </Container>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const initialScrolled = header?.dataset.initialScrolled === 'true';

  if (header) {
    if (initialScrolled) {
      // Внутренние страницы: класс уже стоит, просто следим, чтобы не снять.
      // Скролл ничего не меняет — фон всегда кремовый.
    } else {
      // Главная: прозрачная шапка, при скролле > 20px добавляем is-scrolled.
      const onScroll = () => {
        if (window.scrollY > 20) header.classList.add('is-scrolled');
        else header.classList.remove('is-scrolled');
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  // -------- Мобильное меню --------
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (burger && nav) {
    const toggle = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      nav.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      toggle(!open);
    });

    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) toggle(false);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }
</script>