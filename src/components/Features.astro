---
import Container from '@/components/Container.astro';
import { features } from '@/content/features';
---

<section class="features">
  <Container>
    <ul class="features__list">
      {features.map((feature) => (
        <li class="features__item">
          <h3 class="features__title">{feature.title}</h3>
          <p class="features__desc">{feature.text}</p>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .features {
    padding-block: var(--space-8);
    background: var(--color-bg);
  }

  @media (min-width: 768px) {
    .features { padding-block: var(--space-9); }
  }

  /* -------- Сетка: 1 / 2 / 4 колонки -------- */
  .features__list {
    list-style: none;
    display: grid;
    gap: var(--space-6) var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .features__list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .features__list {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
  }

  /* -------- Карточка: тонкая линия сверху + заголовок + текст -------- */
  .features__item {
    padding-top: var(--space-5);
    border-top: 2px solid var(--color-accent-terra);
  }

  .features__title {
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    line-height: 1.25;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    letter-spacing: -0.01em;
  }

  .features__desc {
    font-size: var(--fs-base);
    color: var(--color-text-secondary);
    line-height: var(--lh-base);
    margin: 0;
  }

  @media (min-width: 1024px) {
    .features__title { font-size: var(--fs-lg); }
  }
</style>