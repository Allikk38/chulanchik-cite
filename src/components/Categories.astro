---
import { Picture } from 'astro:assets';
import Container from '@/components/Container.astro';
import { categories } from '@/content/categories';
import { withBase } from '@/utils/seo';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '@/assets/images/cat-*.jpg',
  { eager: true }
);

function getCategoryImage(name: string) {
  const key = Object.keys(images).find((k) => k.includes(`/${name}.`));
  if (!key) {
    throw new Error(
      `Не найдено фото категории: ${name}. Проверь, что файл src/assets/images/${name}.jpg существует.`
    );
  }
  return images[key].default;
}
---

<section class="categories">
  <Container>
    <header class="categories__header">
      <h2 class="categories__title">Популярные категории</h2>
      <a href={withBase('/catalog')} class="categories__all">
        Смотреть все
      </a>
    </header>

    <ul class="categories__list">
      {categories.map((cat) => (
        <li>
          <a href={withBase('/catalog')} class="categories__item">
            <span class="categories__media">
              <Picture
                src={getCategoryImage(cat.image)}
                alt={cat.title}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[240, 360, 520, 720, 1000]}
                sizes="(max-width: 639px) 50vw, 33vw"
                quality={88}
                loading="lazy"
              />
            </span>
            <span class="categories__name">
              <span class="categories__name-inner">{cat.title}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .categories {
    padding-block: var(--space-7) var(--space-6);
    background: var(--color-bg-secondary);
  }

  /* -------- Заголовок + ссылка -------- */
  .categories__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .categories__title {
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: var(--fw-bold);
    letter-spacing: -0.01em;
  }

  .categories__all {
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .categories__all:hover { color: var(--color-primary); }

  /* -------- Сетка: 2 / 3 колонки -------- */
  .categories__list {
    list-style: none;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 640px) {
    .categories__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  /* -------- Плитка -------- */
  .categories__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--color-text);
    gap: var(--space-3);
    transition: transform var(--transition-base);
  }

  .categories__item:hover {
    transform: translateY(-4px);
  }

  /* Подложка + маска для зума */
  .categories__media {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base);
    position: relative;
  }

  .categories__item:hover .categories__media {
    box-shadow: var(--shadow-lg);
  }

  /* Picture рендерит <picture> — растягиваем его на всю плитку */
  .categories__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .categories__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .categories__item:hover .categories__media :global(img) {
    transform: scale(1.06);
  }

  /* -------- Подпись -------- */
  .categories__name {
    display: inline-flex;
    justify-content: center;
    position: relative;
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    color: var(--color-text);
    padding-bottom: 4px;
    transition: color var(--transition-base);
    max-width: 100%;
  }

  .categories__name-inner {
    display: inline-block;
    text-align: center;
  }

  .categories__name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .categories__item:hover .categories__name {
    color: var(--color-primary);
  }

  .categories__item:hover .categories__name::after {
    transform: scaleX(1);
  }

  @media (max-width: 639px) {
    .categories__name { font-size: var(--fs-base); }
  }
</style>