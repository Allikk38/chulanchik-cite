---
import { Picture } from 'astro:assets';
import Container from '@/components/Container.astro';
import { withBase } from '@/utils/seo';
import previewImage from '@/assets/images/cat-other.jpg';
---

<section class="catalog-stub">
  <div class="catalog-stub__bg" aria-hidden="true">
    <Picture
      src={previewImage}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[800, 1200, 1600, 2000, 2400, 3000]}
      sizes="100vw"
      quality={88}
      loading="lazy"
    />
    <div class="catalog-stub__overlay"></div>
  </div>

  <Container>
    <div class="catalog-stub__content">
      <h2 class="catalog-stub__title">Каталог скоро откроется</h2>
      <p class="catalog-stub__text">
        Мы готовим витрину — с фотографиями, описаниями и ценами.
        Пока всё собирается, заходите в магазин лично или напишите нам.
      </p>
      <a href={withBase('/contacts')} class="btn btn--light">
        Связаться с нами
      </a>
    </div>
  </Container>
</section>

<style>
  .catalog-stub {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #ffffff;
    display: flex;
    align-items: center;
    min-height: 300px;
    padding-block: var(--space-6);
  }

  @media (min-width: 768px) {
    .catalog-stub {
      min-height: 340px;
      padding-block: var(--space-7);
    }
  }

  /* -------- Фон: абсолютно позиционированный, на всю секцию -------- */
  .catalog-stub__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .catalog-stub__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Затемнение: центр темнее — там текст */
  .catalog-stub__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(15, 25, 18, 0.75) 0%,
      rgba(15, 25, 18, 0.55) 55%,
      rgba(15, 25, 18, 0.4) 100%
    );
  }

  /* -------- Контент поверх фона -------- */
  .catalog-stub > .container {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .catalog-stub__content {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .catalog-stub__title {
    color: #ffffff;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.3);
  }

  .catalog-stub__text {
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.9);
    line-height: var(--lh-base);
    margin-bottom: var(--space-6);
    max-width: 48ch;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.25);
  }
</style>