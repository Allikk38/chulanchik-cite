---
import Container from '@/components/Container.astro';
import { showcase } from '@/content/showcase';
import { withBase } from '@/utils/seo';
---

<section class="showcase">
  <Container>
    <header class="showcase__header">
      <div>
        <h2 class="showcase__title">Сейчас на витрине</h2>
        <p class="showcase__lead">
          Несколько вещей, которые уже ждут нового хозяина.
        </p>
      </div>
      <a href={withBase('/catalog')} class="showcase__all">
        Смотреть каталог
      </a>
    </header>

    <ul class="showcase__list">
      {showcase.map((item) => (
        <li class="showcase__item">
          <a href={withBase('/catalog')} class="showcase__link">
            {item.badge && (
              <span class="showcase__badge">{item.badge}</span>
            )}
            <span class="showcase__name">{item.title}</span>
            <span class="showcase__price">{item.price}</span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .showcase {
    padding-block: var(--space-8) var(--space-8);
    background: var(--color-bg);
  }

  @media (min-width: 768px) {
    .showcase { padding-block: var(--space-9) var(--space-9); }
  }

  /* -------- Заголовок + ссылка -------- */
  .showcase__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .showcase__title {
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: var(--fw-bold);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }

  .showcase__lead {
    font-size: var(--fs-base);
    color: var(--color-text-secondary);
    max-width: 40ch;
  }

  .showcase__all {
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .showcase__all:hover { color: var(--color-primary); }

  /* -------- Сетка: 1 / 2 / 4 -------- */
  .showcase__list {
    list-style: none;
    display: grid;
    gap: var(--space-6) var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .showcase__list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .showcase__list {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-7);
    }
  }

  /* -------- Колонка прайса -------- */
  .showcase__item {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .showcase__link {
    display: block;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  /* Бейдж — маленькая надпись сверху, не пилюля */
  .showcase__badge {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-terra);
    margin-bottom: var(--space-2);
  }

  .showcase__name {
    display: block;
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
    line-height: 1.35;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .showcase__price {
    display: block;
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    color: var(--color-text);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .showcase__link:hover .showcase__name,
  .showcase__link:hover .showcase__price {
    color: var(--color-primary);
  }
</style>